# Database provider
# Leave the Cosmos settings blank (or set DB_PROVIDER=local) to use the
# built-in local JSON store — no Azure account needed for development.
# DB_PROVIDER=local
# LOCAL_DB_FILE=./data/local-db.json

# Azure Cosmos DB Configuration (production)
COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DB_KEY=your-primary-key-here
COSMOS_DB_DATABASE=register

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://register-chi-seven.vercel.app

# Rate limits per 15 minutes (a whole classroom shares one IP)
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
